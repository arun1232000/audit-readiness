{
  "name": "audit-readiness-check",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c yellow,cyan \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "build": "npm run typecheck && npm run lint && vite build && npm run build:server",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist-server/index.js",
    "start": "node dist-server/index.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:web3forms": "playwright test -c playwright.web3forms.config.ts",
    "hubspot:setup": "tsx server/scripts/setup-hubspot-properties.ts",
    "queue:flush": "tsx server/scripts/flush-queue.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^3.10.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "gsap": "^3.15.1",
    "helmet": "^8.3.0",
    "libphonenumber-js": "^1.13.16",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.92.0",
    "react-phone-number-input": "^3.4.18",
    "three": "^0.170.0",
    "zod": "^3.25.76",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^6.0.3",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "concurrently": "^9.2.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^25.0.1",
    "pino-pretty": "^13.2.0",
    "postcss": "^8.5.33",
    "supertest": "^7.3.2",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "5.6",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  }
}
