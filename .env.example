# ─── Server ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8787
LOG_LEVEL=info
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173
# Express "trust proxy" (number of hops, "loopback", or a subnet). Needed for correct rate limiting behind a proxy.
TRUST_PROXY=loopback
# true = the API also serves the built frontend from ./dist (single-server deploy).
SERVE_STATIC=false

# ─── HubSpot (server only, never prefix with VITE_) ─────────────────────
# Private App access token. Scopes: crm.objects.contacts.read, crm.objects.contacts.write,
# crm.schemas.contacts.write (for the setup script). Notes are created via the contacts scope.
HUBSPOT_ACCESS_TOKEN=your-private-app-access-token
# true = no HubSpot calls; an in-memory mock is used so the full flow can be demoed.
HUBSPOT_MOCK=true
# Mock mode only: pretend HubSpot is down to exercise the retry queue.
HUBSPOT_MOCK_FAIL=false
HUBSPOT_TIMEOUT_MS=10000
HUBSPOT_MAX_RETRIES=3
# Optional, applied only when a NEW contact is created (HubSpot does not allow moving lifecycle backwards).
HUBSPOT_LIFECYCLE_STAGE=lead
HUBSPOT_LEAD_STATUS=NEW

# ─── Retry queue ─────────────────────────────────────────────────────────
QUEUE_DIR=./data
QUEUE_INTERVAL_MS=30000
QUEUE_MAX_ATTEMPTS=20

# ─── Abuse protection ────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10
# Submissions completed faster than this (ms, from opening the form) are rejected as bots.
MIN_COMPLETION_MS=4000
# Cloudflare Turnstile (optional). Set both the server secret and the public site key.
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=

# ─── Frontend (public, baked into the bundle at build time) ──────────────
# Leave empty when the API is served from the same origin (default, and in dev via the Vite proxy).
VITE_API_BASE_URL=
VITE_TURNSTILE_SITE_KEY=
